rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function publicChannel(channelId) {
      return exists(/databases/$(database)/documents/channels/$(channelId))
        && get(/databases/$(database)/documents/channels/$(channelId)).data.isDirectMessage == false;
    }

    // Only authenticated users can see or create public channels.
    // Direct-message documents must never be stored in this public collection.
    match /channels/{channelId} {
      allow read: if signedIn() && resource.data.isDirectMessage == false;
      allow create: if signedIn()
        && request.resource.data.id == channelId
        && request.resource.data.isDirectMessage == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow update: if signedIn()
        && resource.data.isDirectMessage == false
        && request.resource.data.id == channelId
        && request.resource.data.isDirectMessage == false
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageTime'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 10000
        && request.resource.data.lastMessageTime is int;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && publicChannel(channelId);

        allow create: if signedIn()
          && publicChannel(channelId)
          && request.resource.data.id == messageId
          && request.resource.data.channelId == channelId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && request.resource.data.timestamp is int;

        // Only the author can edit or remove their message.
        allow update: if signedIn()
          && publicChannel(channelId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.channelId == resource.data.channelId
          && request.resource.data.id == resource.data.id
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 10000;

        allow delete: if signedIn()
          && publicChannel(channelId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // User-private data, if/when user documents are added.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Deny every other path by default.
  }
}
