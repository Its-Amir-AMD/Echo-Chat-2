rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasOwnUsername(username) {
      return username is string
        && username.matches('^[a-z0-9_]{3,32}$')
        && existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    function isPublicChannel(channelId) {
      return exists(/databases/$(database)/documents/channels/$(channelId))
        && get(/databases/$(database)/documents/channels/$(channelId)).data.isDirectMessage == false;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    // Public directory profile. Email addresses are never stored in this collection.
    // Exact document gets are permitted for signed-in users; listing is deliberately denied.
    match /publicUsers/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && hasOwnUsername(request.resource.data.usernameLower)
        && request.resource.data.username == request.resource.data.usernameLower
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt is int;
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // Handle -> UID lookup uses a single document get, not a query over all users.
    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && usernameLower.matches('^[a-z0-9_]{3,32}$')
        && request.resource.data.usernameLower == usernameLower
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Public rooms. Every signed-in account can read; clients can only update previews.
    match /channels/{channelId} {
      allow read: if signedIn() && resource.data.isDirectMessage == false;
      allow create: if signedIn()
        && request.resource.data.id == channelId
        && request.resource.data.isDirectMessage == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow update: if signedIn()
        && resource.data.isDirectMessage == false
        && request.resource.data.id == channelId
        && request.resource.data.isDirectMessage == false
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageTime'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 10000
        && request.resource.data.lastMessageTime is int;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && isPublicChannel(channelId);

        allow create: if signedIn()
          && isPublicChannel(channelId)
          && request.resource.data.id == messageId
          && request.resource.data.channelId == channelId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && request.resource.data.timestamp is int;

        allow update: if signedIn()
          && isPublicChannel(channelId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.channelId == resource.data.channelId
          && request.resource.data.id == resource.data.id
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 10000;

        allow delete: if signedIn()
          && isPublicChannel(channelId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Private conversations have exactly two distinct members and are only readable
    // by those members. Creation is allowed only if both users have a directory profile.
    match /conversations/{conversationId} {
      // Allow an authenticated exact get of a non-existent ID so clients can determine
      // whether a deterministic conversation already exists before creating it. No data
      // is exposed because the document is absent. Existing documents remain member-only.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.id == conversationId
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && exists(/databases/$(database)/documents/publicUsers/$(request.resource.data.memberIds[0]))
        && exists(/databases/$(database)/documents/publicUsers/$(request.resource.data.memberIds[1]))
        && request.resource.data.memberNames is map
        && request.resource.data.createdAt is int
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageTime is int;

      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.id == resource.data.id
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageTime'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 10000
        && request.resource.data.lastMessageTime is int;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
          && request.resource.data.id == messageId
          && request.resource.data.channelId == conversationId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && request.resource.data.timestamp is int;

        allow update: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.channelId == resource.data.channelId
          && request.resource.data.id == resource.data.id
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 10000;

        allow delete: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Legacy user-private namespace remains available only to its owner.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
